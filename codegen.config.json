{
  "create-react-feature": {
    "page": {
      "folder": "./demo/pages/__Name__",
      "filename": "__Name__.tsx",
      "template": "react/ts"
    }
  },
  "create-express-feature": {
    "model": {
      "folder": "./demo/models",
      "filename": "__name__.model.js",
      "template": "mongoose/es5"
    },
    "controller": {
      "folder": "./demo/controllers",
      "filename": "__name__.controller.js"
    },
    "controller-test": {
      "folder": "./demo/tests/controllers",
      "filename": "__name__.controller.test.js",
      "template": "jest/js"
    },
    "route": {
      "folder": "./demo/routes",
      "filename": "__name__.route.js",
      "template": "express/es5"
    }
  },
  "create-next-feature-1": {
    "page-app-dir": {
      "folder": "./demo/app/__name__",
      "filename": "page.tsx",
      "template": "next/ts"
    },
    "mobule": {
      "folder": "./demo/modules/__Name__",
      "filename": "index.tsx",
      "template": "react/ts"
    },
    "context": {
      "folder": "./demo/modules/__Name__/context",
      "filename": "__Name__Context.tsx",
      "template": "react-context/ts"
    },
    "component": {
      "folder": "./demo/modules/__name__/components",
      "filename": "Example.tsx",
      "template": "react/ts"
    }
  }
}
